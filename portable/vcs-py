            raise Error("copy requires source and destination")
        dest = args[-1]
        for src in args[:-1]:
            if self.p4("integrate", src, dest) != 0:
                rc = run("cp", src, dest) or self.p4("add", dest)
                if rc != 0:
                    return rc
        return 0

