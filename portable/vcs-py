        if self.git_backed():
            return self.jj("git", "fetch", *args)
        return self.mark_synced(self.jj("piper", "pull"))

    def pull(self, args):
        if self.git_backed():
            return self.jj("git", "fetch", *args)
        return self.mark_synced(self.jj("sync", *args))

    def push(self, args):
        if self.git_backed():
            return self.jj("git", "push", *args)
        return self.jj("upload", *args)

    def presubmit(self, args):
        if self.git_backed():
            raise Error("no presubmit for git-backed repos; run tests locally")
        return self.jj("piper", "presubmit", *args)

    def remove(self, args):
        rc = run("rm", *args)
        if rc != 0:
            return rc
        return self.jj("file", "untrack", *args)

    def rename(self, args):
        if len(args) != 2:
            raise Error("usage: rename <source> <dest>")
        return run("mv", args[0], args[1])

    def revert(self, args):
        if not args:
            return self.jj("restore")
        if any(a.startswith("-") for a in args):
            return self.jj("revert", *args)
        return self.jj("restore", *args)

    def review(self, args):
        reviewers, push_flags = _split_reviewers(args, "-r")
        if not self.git_backed():
            return self.jj("upload", *push_flags)
        rc = self.jj("git", "push", *push_flags)
        if rc != 0:
            return rc
        if self.info.hosting == "github" and which("gh"):
            bookmark = try_capture("jj", "bookmark", "list", "-r", "@") or ""
            head = bookmark.split(":", 1)[0].strip() if bookmark else ""
            view = ["pr", "view"] + ([head] if head else []) + [
                "--json", "url", "-q", ".url"]
            if run("gh", *view) != 0:
                create = ["pr", "create", "--fill"]
                if head:
                    create += ["--head", head]
                create += reviewers if reviewers else ["--draft"]
                return run("gh", *create)
        return 0

    def count(self):
        out = capture("jj", "--no-pager", "log", "--no-graph", "-r",
                      "ancestors(@-) ~ root()", "-T", '"x"')
        print(len(out))
        return 0

    def status(self, args):
        if capture("jj", "log", "--no-graph", "-r", "@", "-T",
                   "description") == "":
            return self.jj("diff", "--summary", *args)
        return 0


