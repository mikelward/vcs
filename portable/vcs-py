    def mark_synced(self, rc):
        """Record a successful sync for the prompt's staleness check."""
        if rc == 0 and not DRY_RUN and self.info.root:
            path = os.path.join(self.info.root, JJ_SYNC_MARKER)
            try:
                with open(path, "a"):
                    pass
                os.utime(path, None)
            except OSError as e:
                sys.stderr.write("vcs-jj: cannot record the sync in %s: %s\n"
                                 % (JJ_SYNC_MARKER, e.strerror))
        return rc

