        try:
            root = self.root()
        except (Error, Failed):
            return 0
        for hook in (".p4/hooks/fix", ".g4/hooks/fix"):
            script = os.path.join(root, hook)
            if is_executable_file(script):
                return run(script, *args)
        return 0


