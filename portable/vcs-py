# The local end time, as `touch -t` takes it, of each jj operation that
# brought in upstream changes, newest first. Kept equal to the sh script's.
JJ_SYNC_TIMES = (
    'if(description.lower().contains("fetch") || '
    'description.lower().contains("sync") || '
    'description.lower().contains("pull") || '
    'description.lower().contains("import"), '
    'self.time().end().local().format("%Y%m%d%H%M.%S") ++ "\\n")')


def seed_sync_marker(root, marker):
    """Date a missing sync marker from the last sync in jj's operation log,
    so a workspace `vcs pull` hasn't synced yet isn't reminded for nothing.
    With no sync recorded it's dated 2000 and the reminder shows; if jj
    fails, its error is shown, no marker is made, and the next prompt asks
    again."""
    try:
        out = capture("jj", "-R", root, "op", "log", "--no-graph",
                      "--ignore-working-copy", "-T", JJ_SYNC_TIMES)
    except (Error, Failed) as e:
        detail = (e.stderr.strip() if isinstance(e, Failed)
                  else str(e.args[0]))
        sys.stderr.write(
            "vcs prompt-info: jj op log in %s failed, so the last sync is "
            "unknown%s\n" % (os.path.basename(root),
                             ": " + detail if detail else ""))
        return
    first = out.split("\n", 1)[0] or "200001010000.00"
    try:
        when = time.mktime(time.strptime(first, "%Y%m%d%H%M.%S"))
    except ValueError:
        # Unparseable: date it 2000, so the reminder shows.
        when = time.mktime(time.strptime("200001010000.00",
                                         "%Y%m%d%H%M.%S"))
    try:
        with open(marker, "a"):
            pass
        os.utime(marker, (when, when))
    except OSError:
        pass  # A read-only workspace: the reminder shows, as with no marker.


def status_and_behind(info, hg_path, need_status, need_behind):
    """("*" or "", behind) for the repository described by info.

    If a probe fails, its error and what that leaves unknown go to stderr,
    and the prompt renders without status or "pull"."""
    try:
        return _status_and_behind(info, hg_path, need_status, need_behind)
    except _ProbeFailed:
        return "", False


class _ProbeFailed(Exception):
    pass


def _probe(name, root, *argv):
    try:
        return capture(*argv)
    except (Error, Failed) as e:
        detail = e.stderr if isinstance(e, Failed) else e.args[0] + "\n"
        sys.stderr.write(detail if detail.endswith("\n") or not detail
                         else detail + "\n")
        sys.stderr.write("vcs prompt-info: %s in %s failed, so its status is "
                         "unknown\n" % (name, os.path.basename(root)))
        raise _ProbeFailed()


def _status_and_behind(info, hg_path, need_status, need_behind):
    root = info.root
    status, behind = "", False
    if info.vcs == "git":
        out = _probe("git status", root, "git", "-C", root, "status",
                     "--branch", "--porcelain", "--untracked-files=all")
        first, _, rest = out.partition("\n")
        status = "*" if rest.strip() else ""
        behind = "..." in first and "behind " in first
        if need_behind and not behind:
            behind = _older_than(os.path.join(git_dir(root), "FETCH_HEAD"),
                                 STALE_SECONDS)
    elif info.vcs == "hg":
        hg = hg_path or find_hg()
        if need_behind:
            out = _probe("hg summary", root, hg, "-R", root, "summary")
            for line in out.split("\n"):
                if line.startswith("commit:"):
                    commit = line[len("commit:"):].strip()
                    if commit != "(clean)" and not commit.startswith(
                            "(clean) "):
                        status = "*"
                elif line.startswith("update:"):
                    if line[len("update:"):].strip() not in ("",
                                                             "(current)"):
                        behind = True
            if not need_status:
                status = ""
            behind = behind or _older_than(
                os.path.join(root, ".hg", "store", "00changelog.i"),
                STALE_SECONDS)
        elif _probe("hg status", root, hg, "-R", root, "status").strip():
            status = "*"
    elif info.vcs == "jj":
        if info.backend in ("", "git"):
            if need_behind:
                tmpl = ('if(self.contained_in("@"), "@" ++ ' + JJ_DIRTY +
                        ' ++ "\\n", if(self.contained_in("ancestors(@)"), '
                        '"upstream\\n", "behind\\n"))')
                out = _probe("jj log", root, "jj", "-R", root, "log",
                             "--no-graph", "-r", "@ | remote_bookmarks()",
                             "-T", tmpl)
                lines = out.split("\n")
                status = "*" if "@*" in lines else ""
                behind = "behind" in lines or _older_than(
                    os.path.join(jj_git_dir(root), "FETCH_HEAD"),
                    STALE_SECONDS)
            else:
                status = _probe("jj log", root, "jj", "-R", root, "log",
                                "--no-graph", "-r", "@", "-T", JJ_DIRTY)
        else:
            if need_status:
                status = _probe("jj log", root, "jj", "-R", root, "log",
                                "--no-graph", "-r", "@", "-T", JJ_DIRTY)
            if need_behind:
                marker = os.path.join(root, JJ_SYNC_MARKER)
                if not os.path.exists(marker):
                    seed_sync_marker(root, marker)
                behind = (not os.path.exists(marker)
                          or _older_than(marker, STALE_SECONDS))
    if status != "*":
        status = ""
    return status, behind


def gather(info, fields, hg_path=""):
    r = PromptResult()
    if "project" in fields:
        r.project = os.path.basename(info.root) or info.root
    if "subdir" in fields:
        rel = os.path.relpath(getwd(), info.root) if info.root else "."
        r.subdir = "" if rel == "." else rel
    if "branch" in fields:
        if info.vcs == "git":
            r.branch = git_branch(info.root)
        elif info.vcs == "hg":
            r.branch = read_first_line(
                os.path.join(info.root, ".hg", "branch")) or "default"
    if "status" in fields or "behind" in fields:
        status, behind = status_and_behind(info, hg_path, "status" in fields,
                                           "behind" in fields)
        if "status" in fields:
            r.status = status
        if "behind" in fields:
            r.behind = behind
    return r


def _color(text, code, color):
    if not color or not text:
        return text
    return "\033[%sm%s\033[0m" % (code, text)


def format_prompt(r, fmt, color):
    s = fmt.replace("\\n", "\n").replace("\\t", "\t")
    for name, value in (
            ("project", _color(r.project, "32", color)),
            ("subdir", _color(r.subdir, "34", color)),
            ("branch", r.branch),
            ("status", _color(r.status, "33", color)),
            ("behind", _color("pull" if r.behind else "", "33", color))):
        s = s.replace("{" + name + "}", value)
    lines = []
    for line in s.split("\n"):
        while "  " in line:
            line = line.replace("  ", " ")
        lines.append(line.rstrip(" "))
    return "\n".join(lines).rstrip("\n")


def color_mode(mode):
    if mode == "always":
        return True
    if mode == "never":
        return False
    return sys.stdout.isatty()


def _flag_value(args, i, name):
    """(value, next index) if args[i] is --name=V or --name V, else None."""
    a = args[i]
    if a.startswith("--" + name + "="):
        return a[len(name) + 3:], i + 1
    if a == "--" + name and i + 1 < len(args):
        return args[i + 1], i + 2
    return None


def prompt_info_cmd(force, hg_path, args):
    fmt, mode = DEFAULT_FORMAT, "auto"
    i = 0
    while i < len(args):
        for name in ("hg-path", "format", "color"):
            got = _flag_value(args, i, name)
            if got is not None:
                value, i = got
                if name == "hg-path":
                    hg_path = value
                elif name == "format":
                    fmt = value
                else:
                    mode = value
                break
        else:
            raise Error("unknown flag: %s" % args[i], "vcs prompt-info")
    info = detect_or_exit(force)
    result = gather(info, parse_fields(fmt), hg_path)
    print(format_prompt(result, fmt, color_mode(mode)))
    return 0


# --- prompt-line -------------------------------------------------------------

def ssh_agent_has_keys(sock, timeout=0.5):
    """One REQUEST_IDENTITIES round trip to the agent at sock."""
    if not sock:
        return False
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(timeout)
    try:
        s.connect(sock)
        s.sendall(b"\0\0\0\1\x0b")
        data = b""
        while len(data) < 9:
            chunk = s.recv(9 - len(data))
            if not chunk:
                return False
            data += chunk
    except (OSError, socket.timeout):
        return False
    finally:
        s.close()
    length, kind, nkeys = struct.unpack(">IBI", data)
    return length >= 5 and kind == 12 and nkeys > 0


def tilde(cwd, home):
    if not home:
        return cwd
    if cwd == home:
        return "~"
    if cwd.startswith(home + "/"):
        return "~" + cwd[len(home):]
    return cwd


def prompt_line_cmd(force, hg_path, args):
    hostname = ""
    production = False
    shpool = os.environ.get("SHPOOL_SESSION_NAME", "")
    fmt, mode, check_ssh = DEFAULT_FORMAT, "auto", True
    i = 0
    while i < len(args):
        a = args[i]
        if a == "--production":
            production, i = True, i + 1
            continue
        if a == "--no-ssh":
            check_ssh, i = False, i + 1
            continue
        for name in ("hostname", "shpool", "hg-path", "format", "color"):
            got = _flag_value(args, i, name)
            if got is not None:
                value, i = got
                if name == "hostname":
                    hostname = value
                elif name == "shpool":
                    shpool = value
                elif name == "hg-path":
                    hg_path = value
                elif name == "format":
                    fmt = value
                else:
                    mode = value
                break
        else:
            raise Error("unknown flag: %s" % a, "vcs prompt-line")
    if not hostname:
        hostname = (os.environ.get("HOSTNAME") or socket.gethostname()
                    ).split(".")[0]
    color = color_mode(mode)

    host = hostname
    if color and production:
        host = "\033[31m%s\033[0m" % host
    if shpool:
        tag = " [" + _color(shpool, "32", color) + "]"
    else:
        tag = " " + _color("shpool", "33", color)

    cwd = getwd()
    home = os.environ.get("HOME", "")
    err = None
    info = detect(cwd)
    if force:
        info = info or Info(force, root=cwd)
        info.vcs = force
    if info is None:
        directory = tilde(cwd, home)
    else:
        try:
            directory = format_prompt(
                gather(info, parse_fields(fmt), hg_path), fmt, color)
        except Error as e:
            directory, err = "", e
        directory = directory or tilde(cwd, home)
    if color:
        directory = "\033[34m%s\033[0m" % directory

    line = host + tag + " " + directory
    if check_ssh and not ssh_agent_has_keys(
            os.environ.get("SSH_AUTH_SOCK", "")):
        line += " " + _color("SSH", "33", color)
    if err is not None:
        sys.stderr.write("vcs prompt-line: %s\n" % err)
    print(line)
    return 0


# --- main ----------------------------------------------------------------------

def version_info():
    commit, date = COMMIT, DATE
    if commit.startswith("@"):
        here = os.path.dirname(os.path.realpath(__file__))
        out = try_capture("git", "-C", here, "log", "-1", "--format=%H %cI")
        commit, date = out.split(" ", 1) if out else ("unknown", "unknown")
    return commit, date


def detect_or_exit(force):
    info = detect(getwd())
    if force:
        info = info or Info(force)
        info.vcs = force
        return info
    if info is None:
        sys.stderr.write("vcs: no version control system detected\n")
        sys.exit(1)
    return info


def main(argv):
    global DRY_RUN
    force, hg_path = "", ""
    i = 0
    while i < len(argv):
        a = argv[i]
        if a.startswith("--vcs="):
            force, i = a[len("--vcs="):], i + 1
        elif a == "--vcs" and i + 1 < len(argv):
            force, i = argv[i + 1], i + 2
        elif a.startswith("--hg-path="):
            hg_path, i = a[len("--hg-path="):], i + 1
        elif a == "--hg-path" and i + 1 < len(argv):
            hg_path, i = argv[i + 1], i + 2
        elif a in ("-n", "--dry-run", "--simulate"):
            DRY_RUN, i = True, i + 1
        elif a in ("--version", "-V"):
            print("vcs portable (commit %s, built %s)" % version_info())
            return 0
        else:
            break
    if DRY_RUN:
        os.environ["VCS_DRY_RUN"] = "1"
    rest = argv[i:]
    if not rest:
        sys.stderr.write("usage: vcs [--vcs=NAME] [--hg-path=PATH] "
                         "[-n|--dry-run] <subcommand> [args...]\n")
        return 1
    sub, args = rest[0], rest[1:]

    if sub == "--list-commands":
        print("\n".join(COMMANDS))
        return 0
    if sub == "version":
        print("vcs\nversion: portable\ncommit:  %s\nbuilt:   %s"
              % version_info())
        return 0
    if sub == "detect":
        if len(args) > 1:
            raise Error("too many arguments", "vcs detect")
        directory = getwd()
        if args:
            try:
                st = os.stat(args[0])
            except OSError as e:
                raise Error("stat %s: %s" % (args[0], e.strerror), "vcs detect")
            directory = args[0] if stat.S_ISDIR(st.st_mode) \
                else os.path.dirname(args[0]) or "."
        info = detect(directory)
        if force:
            print(force)
        elif info is None:
            sys.stderr.write("vcs: no version control system detected\n")
            return 1
        else:
            print(info.vcs)
        return 0
    if sub == "rootdir":
        root = detect_or_exit(force).root
        for a in args or [""]:
            print(os.path.normpath(root + "/" + a) if a else root)
        return 0
    if sub in ("backend", "hosting"):
        info = detect_or_exit(force)
        value = info.backend if sub == "backend" else info.hosting
        if value:
            print(value)
        return 0
    if sub == "prompt-info":
        return prompt_info_cmd(force, hg_path, args)
    if sub == "prompt-line":
        return prompt_line_cmd(force, hg_path, args)
    if sub == "auto-fetch":
        # Background fetching is off in the portable version (TODO.md).
        if "--verbose" in args or "-v" in args:
            print("disabled")
        return 0
    if sub == "clearcache":
        for d, _, files in os.walk("."):
            if ".vcs_cache" in files:
                try:
                    os.remove(os.path.join(d, ".vcs_cache"))
                except OSError:
                    pass  # As the Go version: skip what can't be removed.
        return 0

    info = detect_or_exit(force)
    if info.vcs == "git":
        backend = Git(info)
    elif info.vcs == "hg":
        backend = Hg(info, hg_path)
    elif info.vcs == "jj":
        backend = Jj(info)
    elif info.vcs == "p4":
        backend = P4(info)
    else:
        raise Error("unsupported VCS: %s" % info.vcs)
    try:
        return backend.dispatch(sub, args)
    except Error as e:
        raise Error("%s" % e, "vcs-" + backend.name)


def entry():
    try:
        rc = main(sys.argv[1:])
    except Error as e:
        prog = e.args[1] if len(e.args) > 1 else "vcs"
        sys.stderr.write("%s: %s\n" % (prog, e.args[0]))
        rc = 1
    except Failed as e:
        if e.stderr:
            sys.stderr.write(e.stderr if e.stderr.endswith("\n")
                             else e.stderr + "\n")
        rc = e.code
    except KeyboardInterrupt:
        rc = 130
    try:
        sys.stdout.flush()
    except BrokenPipeError:
        # Output went to a closed pipe (e.g. `| head`): nothing more to show.
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
    sys.exit(rc)


if __name__ == "__main__":
    entry()
