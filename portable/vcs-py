                                       "--config", "hooks.pre-commit=",
                                       "commit", *a),
            "copy": lambda a: h("copy", *a),
            "count": lambda a: self.count(),
            "diffedit": lambda a: h("histedit", *a),
            "diffstat": lambda a: h("diff", "--stat", *a),
            "drop": lambda a: h("prune", *a),
            "evolve": lambda a: h("evolve", *a),
            "fastforward": lambda a: self.fastforward(),
            "fetchtime": lambda a: print_mtime(os.path.join(
                capture(self.cmd, "root"), ".hg", "store", "00changelog.i")),
            "fix": lambda a: h("fix", *a),
            "graft": lambda a: h("graft", *a),
            "pick": lambda a: h("graft", *a),
