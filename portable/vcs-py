        base = ["pull", "--update", "--rebase"]
        if self.config_bool("commands.update.requiredest"):
            base = ["--config", "commands.update.requiredest=no"] + base
        if self.config_bool("commands.rebase.requiredest"):
            base = ["--config", "commands.rebase.requiredest=no"] + base
        return self.hg(*base + args)

    def fastforward(self):
        rc = self.hg("sync", "--tool=internal:fail")
        if rc != 0:
            self.hg("rebase", "--abort")
        return rc

    def graph(self, args):
        if not args:
            revset = ("(draft() and not obsolete()) or "
                      "parents(roots(draft() and not obsolete()))")
            return self.hg("log", "--graph", "--template", "oneline", "-r",
                           revset)
        return self.hg("log", "--graph", "--template", "oneline", *args)

    def count(self):
        print(len(capture(self.cmd, "--pager", "never", "log", "-r",
                          "ancestors(.)+.", "--template", "x")))
        return 0


def find_hg(warn=False):
    if which("chg"):
        return which("chg")
    if warn:
        sys.stderr.write("vcs-hg: warning: chg not found, falling back to hg "
                         "(expect slower performance)\n")
    return "hg"


