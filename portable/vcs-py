        Backend.__init__(self, info)
        self.cmd = hg_path or find_hg(warn=True)

    def hg(self, *args):
        return run(self.cmd, "--pager", "never", *args)

    def commands(self):
        h = self.hg
        return {
            "absorb": lambda a: h("--config", "extensions.absorb=", "absorb",
                                  "--apply-changes", *a),
            "add": lambda a: h("add", *a),
            "track": lambda a: h("add", *a),
            "addremove": lambda a: h("addremove", *a),
            "amend": lambda a: h("amend", *a),
            "annotate": lambda a: h("annotate", *a),
            "at_tip": lambda a: self.at_tip(),
            "base": lambda a: h("log", "-r", ".", "--template", self.ONELINE,
                                *a),
            "blame": lambda a: h("blame", *a),
            "branch": lambda a: h("branch"),
            "branches": lambda a: h("branches", *a),
            "change": self.change,
            "describe": self.change,
            "changed": lambda a: (h("log", "--template", "{files}\\n", *a)
                                  if a else h("status", "--no-status")),
            "changelog": lambda a: h("log", "--template", self.ONELINE, *a),
            "changes": lambda a: h("diff", *a),
            "diffs": lambda a: h("diff", *a),
            "checkout": lambda a: h("checkout", *a),
            "goto": lambda a: h("update", *a),
            "commit": lambda a: h("commit", *a),
