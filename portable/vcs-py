class Error(Exception):
    """A failure to report as "<program>: <message>", exiting 1."""


class Failed(Exception):
    """A captured command failed; its stderr is shown, then its exit code."""

    def __init__(self, code, stderr):
        Exception.__init__(self, code)
        self.code = code
        self.stderr = stderr


# --- running commands ----------------------------------------------------

_SAFE = set("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"
            "0123456789/._-:=,@+%")


def shell_quote(s):
    if s == "":
        return "''"
    if all(c in _SAFE for c in s):
        return s
    return "'" + s.replace("'", "'\\''") + "'"


def print_command(argv):
    sys.stderr.write("+ " + " ".join(shell_quote(a) for a in argv) + "\n")
    sys.stderr.flush()


def _exit_code(rc):
    return 128 - rc if rc < 0 else rc


def run(*argv, **kwargs):
    """Run a command with our stdio, or print it under --dry-run."""
    if DRY_RUN:
        print_command(argv)
        return 0
    sys.stdout.flush()
    try:
        return _exit_code(subprocess.call(list(argv), **kwargs))
    except OSError as e:
        raise Error("exec: %s: %s" % (argv[0], e.strerror))


def capture(*argv, **kwargs):
    """Run a command and return its stdout without trailing newlines."""
    try:
        p = subprocess.Popen(list(argv), stdout=subprocess.PIPE,
                             stderr=subprocess.PIPE,
                             universal_newlines=True, **kwargs)
    except OSError as e:
        raise Error("exec: %s: %s" % (argv[0], e.strerror))
    out, err = p.communicate()
    if p.returncode != 0:
        raise Failed(_exit_code(p.returncode), err)
    return out.rstrip("\n")


def try_capture(*argv, **kwargs):
    """capture, returning None when the command fails or is missing."""
    try:
        return capture(*argv, **kwargs)
    except (Error, Failed):
        return None


def clean_git_env():
    env = dict(os.environ)
    for k in GIT_STATE_VARS:
        env.pop(k, None)
    return env


def which(name):
    return shutil.which(name)


def succeeds(fn, *args):
    try:
        fn(*args)
        return True
    except (Error, Failed):
        return False


def append_lines(path, lines):
    try:
        with open(path, "a") as f:
            for line in lines:
                f.write(line + "\n")
    except OSError as e:
        raise Error("open %s: %s" % (path, e.strerror))
    return 0


def print_mtime(path):
    try:
        print(int(os.stat(path).st_mtime))
    except OSError as e:
        raise Error("stat %s: %s" % (path, e.strerror))
    return 0


def is_executable_file(path):
    try:
        st = os.stat(path)
    except OSError:
        return False
    return stat.S_ISREG(st.st_mode) and st.st_mode & 0o111 != 0


def getwd():
    """The working directory, preferring $PWD's spelling as Go does."""
    pwd = os.environ.get("PWD", "")
    if os.path.isabs(pwd):
        try:
            if os.path.samestat(os.stat(pwd), os.stat(".")):
                return pwd
        except OSError:
            pass
    return os.getcwd()


# --- detection -------------------------------------------------------------

class Info(object):
    def __init__(self, vcs="", backend="", hosting="", root=""):
        self.vcs = vcs
        self.backend = backend
        self.hosting = hosting
        self.root = root


def read_first_line(path):
    try:
        with open(path) as f:
            return f.readline().strip()
    except (OSError, UnicodeDecodeError):
        return None


def read_cache(path):
    try:
        with open(path) as f:
            data = f.read()
    except (OSError, UnicodeDecodeError):
        return None
    lines = data.split("\n", 2)
    if len(lines) < 2:
        return None
    fields = lines[0].split()
    if len(fields) < 3:
        return None
    info = Info(fields[0], fields[1], fields[2], lines[1])
    if info.backend == "-":
        info.backend = ""
    if info.hosting == "-":
        info.hosting = ""
    return info


def write_cache(directory, info):
    try:
        with open(os.path.join(directory, ".vcs_cache"), "w") as f:
            f.write("%s %s %s\n%s\n" % (info.vcs, info.backend or "-",
                                        info.hosting or "-", info.root))
    except OSError:
        pass  # Best effort: the directory may be read-only.


MARKERS = ((".jj", "jj"), (".hg", "hg"), (".git", "git"), (".citc", "p4"),
           (".p4config", "p4"))


def detect(directory):
    """Info for the repository containing directory, or None."""
    directory = os.path.normpath(os.path.join(getwd(), directory))
    info = read_cache(os.path.join(directory, ".vcs_cache"))
    if info is not None:
        return info
    d = directory
    vcs = None
    while vcs is None:
        for marker, name in MARKERS:
            if os.path.exists(os.path.join(d, marker)):
                vcs = name
                break
        else:
            parent = os.path.dirname(d)
            if parent == d:
                return None
            d = parent
    info = Info(vcs, root=d)
    if vcs == "jj":
        info.backend = read_first_line(
            os.path.join(jj_repo_dir(d), "store", "type")) or ""
    elif vcs == "git":
        info.backend = "git"
    if info.backend == "git":
        info.hosting = detect_hosting(vcs, d)
    write_cache(directory, info)
    return info


def jj_repo_dir(root):
    """A workspace's repo dir: in a secondary workspace .jj/repo is a file
    holding the path to the main workspace's, relative to .jj."""
    repo = os.path.join(root, ".jj", "repo")
    if os.path.isfile(repo):
        target = read_first_line(repo)
        if target:
            return os.path.normpath(os.path.join(root, ".jj", target))
    return repo


def jj_git_dir(root):
    store = os.path.join(jj_repo_dir(root), "store")
    target = read_first_line(os.path.join(store, "git_target"))
    if target:
        return os.path.normpath(os.path.join(store, target))
    dot_git = os.path.join(root, ".git")
    if os.path.isdir(dot_git):
        return dot_git
    return os.path.join(store, "git")


def git_dir(root):
    """The per-worktree git directory of the checkout at root."""
    dot_git = os.path.join(root, ".git")
    if os.path.isfile(dot_git):
        line = read_first_line(dot_git) or ""
        if line.startswith("gitdir:"):
            return os.path.normpath(
                os.path.join(root, line[len("gitdir:"):].strip()))
    return dot_git


def git_common_dir(root):
    gd = git_dir(root)
    common = read_first_line(os.path.join(gd, "commondir"))
    if common:
        return os.path.normpath(os.path.join(gd, common))
    return gd


def detect_hosting(vcs, root):
    if vcs == "jj":
        config = os.path.join(jj_git_dir(root), "config")
    else:
        config = os.path.join(git_common_dir(root), "config")
    try:
        with open(config) as f:
            lines = f.read().split("\n")
    except (OSError, UnicodeDecodeError):
        return ""
    in_origin = False
    for line in lines:
        line = line.strip()
        if line == '[remote "origin"]':
            in_origin = True
        elif line.startswith("["):
            in_origin = False
        elif in_origin and line.startswith("url") and "=" in line:
            return classify_url(line.split("=", 1)[1].strip())
    return ""


def classify_url(url):
    if "github.com" in url:
        return "github"
    if "gitlab.com" in url or "gitlab." in url:
        return "gitlab"
    if "bitbucket.org" in url:
        return "bitbucket"
    if "sr.ht" in url:
        return "sourcehut"
    if "googlesource.com" in url:
        return "gerrit"
    return ""


# --- backends ----------------------------------------------------------------

class Backend(object):
    name = ""
    label = ""

    def __init__(self, info):
        self.info = info

    def dispatch(self, sub, args):
        fn = self.commands().get(sub)
        if fn is None:
            raise Error("unknown %s subcommand: %s" % (self.label, sub))
        return fn(args)


def _first_is_message(args):
    return bool(args) and not args[0].startswith("-")


def _split_reviewers(args, flag):
    reviewers, rest = [], []
    i = 0
    while i < len(args):
        a = args[i]
        if a in ("-r", "-m", "--reviewer"):
            if i + 1 >= len(args):
                raise Error("%s requires a reviewer argument" % a)
            reviewers += [flag, args[i + 1]]
            i += 2
            continue
        if a.startswith("--reviewer="):
            reviewers += [flag, a[len("--reviewer="):]]
        else:
            rest.append(a)
        i += 1
    return reviewers, rest


class Git(Backend):
    name = label = "git"

    def git(self, *args):
        return run("git", "--no-pager", *args)

    def commands(self):
        g = self.git
        return {
            "absorb": lambda a: g("absorb", *a),
            "add": lambda a: g("add", "--intent-to-add", *a),
            "addremove": lambda a: g("add", "--all", *a),
            "amend": lambda a: self.commit_args(
                ["commit", "--amend", "--no-edit"], a),
            "annotate": lambda a: g("blame", *a),
            "blame": lambda a: g("blame", *a),
            "at_tip": lambda a: self.at_tip(),
            "base": self.base,
            "branch": lambda a: self.branch(),
            "branches": lambda a: g("branch", *a),
            "change": lambda a: g("commit", "--amend", *a),
            "recommit": lambda a: g("commit", "--amend", *a),
            "changed": lambda a: g("diff", "--name-only", *a),
            "changelog": lambda a: g("log", "--oneline", *a),
            "changes": lambda a: g("diff", *a),
            "diffs": lambda a: g("diff", *a),
            "checkout": lambda a: g("checkout", *a),
            "goto": lambda a: g("checkout", *a),
            "commit": lambda a: self.commit_args(["commit"], a),
            "commitforce": lambda a: self.commit_args(
                ["commit"], ["--no-verify"] + a),
            "copy": self.copy,
            "count": lambda a: self.count(),
            "describe": lambda a: g("commit", "--amend", "--only",
                                    "--allow-empty", *a),
            "diffedit": lambda a: g("rebase", "--interactive", *a),
            "diffstat": lambda a: g("diff", "--stat", *a),
            "drop": self.drop,
            "evolve": lambda a: self.fail(
                "no automatic evolve in git; use: "
                "git rebase --onto <new> <old> <branch>"),
            "fastforward": lambda a: g("pull", "--ff-only"),
            "fetchtime": lambda a: print_mtime(os.path.join(
                capture("git", "rev-parse", "--git-dir"), "FETCH_HEAD")),
            "fix": self.fix,
            "graft": lambda a: g("cherry-pick", *a),
            "pick": lambda a: g("cherry-pick", *a),
            "graph": self.graph,
            "histedit": lambda a: g("rebase", "--interactive"),
            "ignore": lambda a: append_lines(os.path.join(
                capture("git", "rev-parse", "--show-toplevel"),
                ".gitignore"), a),
            "incoming": lambda a: g("log", "--oneline", "HEAD..@{upstream}",
                                    *a),
            "unpulled": lambda a: g("log", "--oneline", "HEAD..@{upstream}",
                                    *a),
            "lint": lambda a: g("lint", *a),
            "map": self.map,
            "mergetool": lambda a: g("mergetool", *a),
            "resolve": lambda a: g("mergetool", *a),
            "move": lambda a: g("mv", *a),
            "rename": lambda a: g("mv", *a),
            "mv": lambda a: g("mv", *a),
            "next": lambda a: self.next(),
            "outgoing": self.outgoing,
            "unpushed": self.outgoing,
            "pending": self.pending,
            "precommit": lambda a: self.hook("pre-commit", a),
            "presubmit": lambda a: self.hook("pre-push", a),
            "prev": lambda a: g("checkout", "HEAD~"),
            "pull": self.pull,
            "push": lambda a: g("push", *a),
            "submit": lambda a: g("push", *a),
            "submitforce": lambda a: g("push", "--no-verify", *a),
            "rebase": lambda a: g("rebase", *a),
            "remove": lambda a: g("rm", *a),
            "rm": lambda a: g("rm", *a),
            "restore": lambda a: g("checkout", "--", *a),
            "revert": lambda a: (run("git", "checkout", "--", *a) if a
                                 else run("git", "reset", "--hard", "HEAD")),
            "review": self.review,
            "upload": self.review,
            "uploadchain": self.review,
            "reword": lambda a: g(
                "commit", "--amend", "--only", "--allow-empty",
                *((["-m"] if _first_is_message(a) else []) + a)),
            "rootdir": lambda a: g("rev-parse", "--show-toplevel"),
            "show": lambda a: g("show", *a),
            "split": lambda a: g("rebase", "-i", *a),
            "squash": lambda a: g("merge", "--squash", *a),
            "status": lambda a: g("status", "--short",
                                  "--untracked-files=all", *a),
            "track": lambda a: g("add", "--intent-to-add", *a),
            "unamend": lambda a: g("reset", "--mixed", "HEAD@{1}"),
            "uncommit": lambda a: g("reset", "--soft", "HEAD~"),
            "undo": lambda a: g("reset", "--mixed", "HEAD~"),
            "unknown": lambda a: run(
                "git", "-C", capture("git", "rev-parse", "--show-toplevel"),
