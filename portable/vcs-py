def git_branch(root):
    head = read_first_line(os.path.join(git_dir(root), "HEAD"))
    if not head or not head.startswith("ref: refs/heads/"):
        return ""
    branch = head[len("ref: refs/heads/"):]
    if branch != ".invalid":
        return branch
    # reftable: the HEAD file is a placeholder, so ask git.
    env = clean_git_env()
    try:
        out = capture("git", "-C", root, "symbolic-ref", "--quiet", "HEAD",
                      env=env)
        return out[len("refs/heads/"):] if out.startswith("refs/heads/") \
            else ""
    except Failed as e:
        if e.code != 1:
            raise Error("git symbolic-ref in %s: %s"
                        % (os.path.basename(root), e.stderr.strip()))
    try:
        capture("git", "-C", root, "rev-parse", "--symbolic-full-name",
                "HEAD", env=env)
    except Failed as e:
        raise Error("git rev-parse in %s: %s"
                    % (os.path.basename(root), e.stderr.strip()))
    return ""


