            "unmerged": self.unmerged,
            "untrack": lambda a: g("rm", "--cached", *a),
        }

    @staticmethod
    def fail(message):
        raise Error(message)

    def commit_args(self, base, args):
        flags, files, dashdash = [], [], False
        i = 0
        while i < len(args):
            a = args[i]
            if a == "--":
                dashdash = True
                files = args[i + 1:]
                break
            if a in ("-m", "-C", "-c", "-F", "-t"):
                if i + 1 >= len(args):
                    raise Error("%s requires an argument" % a)
                flags += [a, args[i + 1]]
                i += 2
                continue
            if a.startswith("-"):
                flags.append(a)
            else:
                files = args[i:]
                break
            i += 1
        if not files:
            flags.append("--all")
        return run("git", *(base + flags + (["--"] if dashdash else [])
                            + files))

    def at_tip(self):
        if capture("git", "rev-parse", "--abbrev-ref", "HEAD") == "HEAD":
            raise Error("detached HEAD")
        return 0

    def base(self, args):
        if not succeeds(self.at_tip):
            sys.stdout.write("(detached) ")
        return self.git("log", "-1", "--oneline", "--no-decorate", *args)

    def map(self, args):
        if not succeeds(self.at_tip):
            return self.graph([])
        return self.outgoing(args)

    def outgoing(self, args):
        return self.git("log", "--oneline", "HEAD", "--not", "--remotes",
                        *args)

    def branch(self):
        out = capture("git", "rev-parse", "--abbrev-ref", "HEAD")
        if out != "HEAD":
            print(out)
        return 0

    def graph(self, args):
        fmt = "--pretty=format:%C(auto)%h%C(auto)%d %s"
        if not args:
            base = self.origin_base()
            spec = ["--not", base] if base else ["--not", "--remotes"]
            rc = self.git("log", "--graph", "--boundary", fmt, "--branches",
                          "HEAD", *spec)
            if rc != 0:
                return self.git("log", "--graph", fmt)
            return 0
        return self.git("log", "--graph", fmt, *args)

    @staticmethod
    def origin_base():
        out = try_capture("git", "rev-parse", "--abbrev-ref", "origin/HEAD")
        if out is not None and out != "origin/HEAD":
            return out
        for ref in ("origin/main", "origin/master"):
            if try_capture("git", "rev-parse", "--verify", ref) is not None:
                return ref
        return ""

    def unmerged(self, args):
        base = self.origin_base()
        return self.git("branch", "-v", "--no-merged",
                        *([base] if base else []) + args)

    def hook(self, name, args):
        script = os.path.join(capture("git", "rev-parse", "--git-dir"),
                              "hooks", name)
        if not is_executable_file(script):
            raise Error("no %s hook" % script)
        return run(script, *args)

    def fix(self, args):
        gd = try_capture("git", "rev-parse", "--git-dir")
        if gd is not None:
            script = os.path.join(gd, "hooks", "fix")
            if is_executable_file(script):
                return run(script, *args)
        return self.git("fix", *args)

    def next(self):
        head = capture("git", "rev-parse", "HEAD")
        for line in capture("git", "rev-list", "--children",
                            "--all").split("\n"):
            fields = line.split()
            if len(fields) >= 2 and fields[0] == head:
                return run("git", "checkout", fields[1])
        raise Error("no next commit")

    def pending(self, args):
        if try_capture("git", "rev-parse", "--abbrev-ref",
                       "@{upstream}") is None:
            return self.git("status", "--short", *args)
        return self.git("log", "--oneline", "@{upstream}..HEAD", *args)

    def pull(self, args):
        rc = self.git("pack-refs", "--all")
        if rc != 0:
            return rc
        # Serialize with any other fetch in this repository (the Go vcs's
        # background auto-fetch takes the same lock). Best effort.
        lock = None
        gd = try_capture("git", "rev-parse", "--git-dir")
        if gd is not None:
            lock = fetch_lock(gd)
        try:
            return self.git("pull", "--rebase", "--log", *args)
        finally:
            if lock is not None:
                os.close(lock)

    def drop(self, args):
        if not args:
            raise Error("drop requires a commit argument")
        return self.git("rebase", "--onto", args[0] + "~", args[0])

    def copy(self, args):
        if len(args) < 2:
            raise Error("copy requires source and destination")
        rc = run("cp", *args)
        if rc != 0:
            return rc
        return run("git", "add", args[-1])

    def count(self):
        if try_capture("git", "rev-parse",
                       "--is-shallow-repository") == "true":
            raise Error("count: shallow clone, history is incomplete "
                        "(run: git fetch --unshallow)")
        return self.git("rev-list", "--count", "HEAD")

    def review(self, args):
        reviewers, push_flags = _split_reviewers(args, "--reviewer")
        rc = run("git", "push", *push_flags)
        if rc != 0:
            return rc
        if which("gh"):
            if run("gh", "pr", "view", "--json", "url", "-q", ".url") != 0:
                create = ["pr", "create", "--fill"]
                create += reviewers if reviewers else ["--draft"]
                return run("gh", *create)
        return 0


def fetch_lock(gd):
    """Block until this process holds vcs-fetch.lock in the git dir gd."""
    try:
        import fcntl
    except ImportError:
        return None
    try:
        fd = os.open(os.path.join(gd, "vcs-fetch.lock"),
                     os.O_CREAT | os.O_WRONLY, 0o600)
    except OSError:
        return None
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
    except OSError:
        os.close(fd)
        return None
    return fd


class Hg(Backend):
